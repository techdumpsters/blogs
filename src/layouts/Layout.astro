---
// src/layouts/Layout.astro
import '../styles/global.css'; // <-- WAJIB IMPORT FILE CSS DI SINI!

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
  </head>
  <body class="h-full min-h-screen bg-black">
    <slot />
  </body>
</html>